# Set these as encrypted Cloudflare Pages secrets. Do not commit a real .env file.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# true for Lemon Squeezy test credentials; false only for live credentials.
LEMONSQUEEZY_TEST_MODE=true

# Optional fulfillment email (used in the webhook phase).
RESEND_API_KEY=
ORDERS_FROM_EMAIL=orders@yourdomain.com
FULFILLMENT_EMAIL=
